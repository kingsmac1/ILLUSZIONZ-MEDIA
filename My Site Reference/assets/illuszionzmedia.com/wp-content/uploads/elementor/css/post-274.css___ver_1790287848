/* Card */
.service-card {
  border: 1px solid #eee;
  padding: 60px 20px;
  text-align: center;
  background: #fff;
  transition: all 0.3s ease;
}

/* Icon circle */
.icon-wrap {
  width: 56px;
  height: 56px;
  margin: 0 auto 20px;
  border-radius: 50%;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease;
}

