  box-sizing: border-box;
  font-family: "Georgia", serif;
}

/* GRID */
.course-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

/* CARD */
.course-card {
  border: 1px solid #e5e5e5;
  background: #fff;
  transition: box-shadow 0.35s ease;
}

/* Box shadow on hover */
.course-card:hover {
  box-shadow: 0 12px 30px rgba(0,0,0,0.08);
}

/* IMAGE */
.course-image {
  position: relative;
  overflow: hidden;
}

.course-image img {
  width: 100%;
  display: block;
  filter: grayscale(100%);
  transform: scale(1);
  transition: all 0.4s ease;
}

/* ICON */
.course-icon {
  background: transparent;
  border: none;
}

/* CONTENT */
.course-content {
  padding: 22px;
}

.course-title {
  font-size: 18px;
  margin: 0;
  font-weight: 500;
  transition: font-style 0.3s ease;
}

/* Divider line */
.divider {
  width: 100%;
  height: 1px;
  background: #e5e5e5;
  margin: 14px 0;
}

.course-description {
  font-size: 14px;
  color: #555;
  margin-bottom: 18px;
}

/* META */
.course-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #777;
  margin-bottom: 8px;
}

/* HOVER EFFECTS (LIMITED AS REQUESTED) */
.course-card:hover img {
  filter: grayscale(0%);
  transform: scale(1.06);
}

.course-card:hover .course-icon {
  background: #000;
  color: #fff;
  border-color: #000;
}

.course-card:hover .course-title {
  font-style: italic;
}

/* RESPONSIVE */
@media (max-width: 1100px) {
  .course-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .course-grid {
    grid-template-columns: 1fr;
  }
}/* End custom CSS */
